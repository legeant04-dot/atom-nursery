# ─────────────────────────────────────────────────────────────────────────────
#  Supabase — ค่าเชื่อมต่อ  (TEMPLATE · ไฟล์นี้ commit ได้ เพราะไม่มีค่าจริง)
# ─────────────────────────────────────────────────────────────────────────────
#
#  วิธีใช้:
#    1. คัดลอกไฟล์นี้เป็น  secrets/supabase.env
#    2. เติมค่าจริงจาก Supabase dashboard
#    3. บอกผมว่า "ใส่แล้ว" — ผมอ่านเอง ไม่ต้องพิมพ์ค่าลงในแชท
#
#  🔴 ห้ามวางค่าเหล่านี้ลงในแชท ใน screenshot หรือใน LINE
#     แชทถูกเก็บไว้ · screenshot เคยทำ client secret หลุดมาแล้วครั้งหนึ่ง (2026-09)
#     secrets/ ถูกกันไว้ใน .gitignore แล้ว — ตรวจแล้วว่า git มองไม่เห็น
#
#  ถ้าค่าหลุดเมื่อไหร่: Dashboard → Settings → Database → Reset database password
#  และ Settings → API → Rotate service_role key  (ทำได้ทันที ไม่เสียข้อมูล)
# ─────────────────────────────────────────────────────────────────────────────


# ① สายเชื่อมต่อฐานข้อมูล — อันนี้คือตัวที่ผมต้องใช้จริงๆ
#
#    Dashboard → ปุ่ม "Connect" ด้านบน → แท็บ "Connection string"
#    เลือกแบบ  Session pooler  (ถ้ามีให้เลือก — รองรับ IPv4 ซึ่งเครื่องนี้ใช้อยู่)
#    กด Copy แล้ววางทั้งบรรทัด
#
#    หน้าตาประมาณนี้:
#      postgresql://postgres.abcdefghijkl:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
#    🔴 ต้องแทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูลที่ตั้งตอนสร้าง project
#       (Supabase โชว์ครั้งเดียวตอนสร้าง · ถ้าจำไม่ได้ ให้ Reset database password ใหม่)
#
#    🔴 ลบวงเล็บ [ ] ออกด้วย — แทนทั้งก้อนรวมวงเล็บ ไม่ใช่ใส่รหัสไว้ข้างใน
#         ถูก :  ...postgres.abcdefg:MyPassw0rd@aws-0-...
#         ผิด :  ...postgres.abcdefg:[MyPassw0rd]@aws-0-...
#       (พลาดแบบนี้จริงเมื่อ 09/10 · เซิร์ฟเวอร์ตอบแค่ "password authentication failed"
#        ซึ่งไม่บอกอะไรเลย · ตอนนี้ pg_connect.js ตรวจเจอและบอกให้แล้ว)
SUPABASE_DB_URL=


# ② URL ของ project — ยังไม่ต้องใช้ตอนนี้ แต่ใส่ไว้เลยก็ได้
#    Dashboard → Settings → API → Project URL
#    หน้าตา: https://abcdefghijkl.supabase.co
SUPABASE_URL=


# ③ anon key — กุญแจฝั่งผู้ใช้ ผ่าน RLS ตามปกติ · ปลอดภัยพอจะอยู่ในแอป
#    Dashboard → Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=


# ④ 🔴 service_role key — ข้ามทุก RLS เห็นข้อมูลทุกโรงเรียน
#    ยังไม่ต้องใส่ตอนนี้ · ผมจะขอตอน Phase 2 ที่ต้องเขียน migration จริง
#    Phase 1.3/1.4 ใช้แค่ ① อย่างเดียว
SUPABASE_SERVICE_ROLE_KEY=


# ⑤ ภูมิภาคที่เลือกไว้ — บันทึกไว้เฉยๆ เพื่อให้รายงานความเร็วอ้างอิงได้
#    แนะนำ: Southeast Asia (Singapore)  ap-southeast-1
SUPABASE_REGION=
