# What `gcloud run deploy --source .` may UPLOAD to Google Cloud Build. A WHITELIST: ignore everything,
# then let back in only the files the Dockerfile copies.
#
# 🔴 Never remove the first line. Without it the whole folder goes up — secrets/supabase.env,
#    "Atom Signature.png", the certificate artwork, the fonts. tools/test_cloud_run.js fails if any
#    of those could be uploaded.
/*
!/Dockerfile
!/.gcloudignore

!/server/
/server/*
!/server/host.js
!/server/session.js
!/server/package.json
!/server/gate.js
!/server/write_proven.js
!/server/routes.js
!/server/line_send.js

!/tools/
/tools/*
!/tools/pg_lib.js
!/tools/pg_engine.js
!/tools/pg_migrate.js

!/webapp/
/webapp/*
!/webapp/engine.js

!/src/
/src/*
!/src/Config.gs
!/src/GasEngine.gs
!/src/Leave.gs
!/src/Code.gs
!/src/Db.gs
!/src/Checkin.gs
!/src/Audit.gs
!/src/Auth.gs
!/src/Notify.gs
!/src/Payroll.gs
!/src/Day6.gs
!/src/OtStaff.gs
!/src/OT.gs
!/src/Certificate.gs
!/src/Staff.gs
!/src/Dspm.gs
!/src/DspmAdmin.gs
!/src/Parent.gs
!/src/Journal.gs
!/src/Announce.gs
!/src/Apply.gs
!/src/Line.gs

!/docs/
/docs/*
!/docs/schema/
/docs/schema/*
!/docs/schema/001_init.sql
