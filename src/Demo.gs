/**
 * Demo.gs — โหมดสาธิต (Phase A · ผอ. 2026-10-21)
 * ══════════════════════════════════════════════════════════════════════════════════════════════
 *
 * เจ้าของเนอสเซอรี่ที่เห็นโฆษณาแล้วสนใจ ต้องกดดูระบบได้ทันที ไม่ต้องจองเดโม ไม่ต้องคุยกับเซลส์
 * และไม่ต้องกลัวว่าจะกดอะไรพัง
 *
 * จากรายงานเทียบ 19 แพลตฟอร์ม (ก.ย. 2026): Brightwheel · Procare · Lillio · Playground · Illumine ·
 * LineLeader — **ไม่มีใครบอกราคา และทุกเจ้าต้องจองเดโมคุยกับเซลส์** การกดดูเองได้จึงไม่ใช่
 * ความสะดวก แต่เป็นความต่างทางการขาย
 *
 * ══════════════════════════════════════════════════════════════════════════════════════════════
 * 🔴 กุญแจสองดอก — และเหตุผลที่ต้องมีสองดอก
 *
 * โหมดนี้เปิดได้ก็ต่อเมื่อ **ทั้งสองอย่างนี้เป็นจริงพร้อมกัน**
 *
 *   ① SCHOOL_CONFIG.DemoMode = 'true'        → อยู่ในสมุดงาน (ตั้งผิดสมุดก็ไม่มีผล)
 *   ② Script Property ATOM_DEMO = '1'        → อยู่ที่ตัว Apps Script project (คนละชั้นกัน)
 *
 * ถ้ามีดอกเดียว = ปิด · เสมอ · ไม่มีข้อยกเว้น
 *
 * เพราะอะไร: ถ้าใช้สวิตช์เดียว วันหนึ่งจะมีคนกดเปิดในสมุดงานของโรงเรียนจริง (หรือคัดลอกสมุดงาน
 * สาธิตไปทับ) แล้วระบบของโรงเรียนจริงจะกลายเป็นระบบสาธิตเงียบๆ — ล็อกอินได้โดยไม่ต้องมี LINE
 * **นั่นคือการเปิดประตูข้อมูลเด็กทั้งโรงเรียนให้คนที่รู้ URL**
 *
 * กุญแจสองดอกที่อยู่คนละชั้นกัน ทำให้ "เปิดโดยบังเอิญ" ต้องพลาดสองครั้งในสองที่ ไม่ใช่ครั้งเดียว
 *
 * 🔴 และนี่ยัง **ไม่ใช่** สิ่งที่ทำให้ปลอดภัย — สิ่งที่ทำให้ปลอดภัยคือ **สมุดงานคนละชุดและ
 * deployment คนละตัว** (ดู docs/PHASE_DEMO_TODO_DASHBOARD.md) กุญแจสองดอกคือตาข่ายชั้นที่สอง
 * สำหรับวันที่ใครสักคนทำผิดขั้นตอน ไม่ใช่ตัวมาตรการหลัก
 * ══════════════════════════════════════════════════════════════════════════════════════════════
 */

/** โหมดสาธิตเปิดอยู่หรือไม่ — ต้องจริงทั้งสองชั้น */
function demoOn_() {
  try {
    if (String(getConfig_('DemoMode', 'false')).toLowerCase() !== 'true') return false;
    var k = PropertiesService.getScriptProperties().getProperty('ATOM_DEMO');
    return String(k || '') === '1';
  } catch (e) { return false; }     // อ่านไม่ได้ = ปิด · ค่าปริยายของสวิตช์นี้คือ "ปิด" เสมอ
}

/**
 * สถานะโหมดสาธิต — เส้นทางสาธารณะ เพราะหน้าจอต้องรู้ก่อนล็อกอินว่าจะแสดงปุ่ม "เข้าดูตัวอย่าง" ไหม
 *
 * 🔴 คืนแค่ boolean กับชื่อโรงเรียนสาธิต ไม่คืนอะไรที่เป็นข้อมูลเลย — เส้นทางสาธารณะที่คืนข้อมูล
 * คือเส้นทางที่ไม่มีประตู (บทเรียน listParents, 2026-10-15)
 */
function handleDemoStatus() {
  var on = demoOn_();
  return { demo: on, school: on ? String(getConfig_('SchoolName', 'โรงเรียนตัวอย่าง')) : '' };
}

/* บทบาทที่ให้ทดลองดูได้ — ประกาศไว้ ไม่ได้รับมาจาก client ตรงๆ
 * (ถ้ารับชื่อ role จาก client ดิบๆ วันหนึ่งจะมีคนส่ง role ที่เราไม่ได้ตั้งใจให้มี) */
var DEMO_ROLES_ = { Admin: 1, Teacher: 1, Parent: 1 };

/**
 * ล็อกอินโหมดสาธิต — ไม่ต้องใช้ LINE
 *
 * 🔴 ทำไมต้องมี: ระบบเราล็อกอินด้วย LINE อย่างเดียว คนที่กดมาจากโฆษณายังไม่มี LINE UID ในระบบเรา
 * การขอให้คนแปลกหน้าผูก LINE ก่อนได้ดูสินค้า คือการขอสิ่งที่ไม่มีใครยอมทำ
 *
 * 🔴 และทำไมมันไม่อันตราย: ฟังก์ชันนี้ปฏิเสธทุกครั้งที่ demoOn_() เป็นเท็จ ซึ่งบน deployment ของ
 * โรงเรียนจริงเป็นเท็จเสมอ (ไม่มี Script Property) · เซสชันที่ออกให้ผูกกับ uid ที่ขึ้นต้นด้วย
 * 'DEMO-' เท่านั้น จึงไม่มีทางตรงกับ LineUID ของคนจริงคนไหน
 */
function handleDemoLogin(p) {
  p = p || {};
  if (!demoOn_()) throw apiError_('NOT_DEMO', 'ระบบนี้ไม่ได้เปิดโหมดสาธิต');
  var role = String(p.role || 'Admin');
  if (!DEMO_ROLES_[role]) throw apiError_('BAD_INPUT', 'เลือกบทบาทที่ต้องการดู');
  var link = demoLinkedId_(role);
  var uid = 'DEMO-' + role.toUpperCase();
  var token = issueSession_(uid, role, link.id);
  try { logAudit(uid, 'DEMO_LOGIN', 'DEMO', role); } catch (e) {}
  return { token: token, role: role, uid: uid, linkedId: link.id, name: link.name, demo: true };
}

/** หาเจ้าของบทบาทในข้อมูลสาธิต — คนแรกที่เจอ ถ้าไม่มีเลยก็คืนค่าว่างให้หน้าจอบอกว่ายังไม่ได้สร้าง */
function demoLinkedId_(role) {
  try {
    if (role === 'Parent') {
      var pa = readObjects_(sheet_(getMainSpreadsheet_(), 'PARENTS'))[0];
      return pa ? { id: String(pa.ParentID), name: String(pa.Name || pa.NameTH || '') } : { id: '', name: '' };
    }
    var st = readObjects_(sheet_(getHrSpreadsheet_(), 'STAFF')).filter(function (s) {
      var r = String(s.Role || ''), l = String(s.PositionLevel || '');
      return role === 'Admin' ? (r === 'Admin' || l === 'Admin') : (r === 'Teacher' && l !== 'Admin');
    })[0];
    return st ? { id: String(st.StaffID), name: String(st.Name || st.NameTH || '') } : { id: '', name: '' };
  } catch (e) { return { id: '', name: '' }; }
}

/**
 * คืนข้อมูลสาธิตกลับเป็นค่าตั้งต้น
 *
 * 🔴 ทำไมต้องมี: คนก่อนหน้าลองกดแก้อะไรไว้ แล้วคนต่อไปจะเห็นหน้าจอที่พัง — เดโมที่ดูแล้วรก
 * ไม่ได้ขายของให้ใคร · และคนที่กำลังลองอยู่ต้อง "กล้ากด" ได้ ซึ่งแปลว่าต้องมีปุ่มเอาคืน
 *
 * ยังไม่เขียนตัวสร้างข้อมูลในไฟล์นี้ — มันต้องใช้ชุดข้อมูลที่ตั้งใจออกแบบให้ "ดูเหมือนโรงเรียนจริง"
 * (มีเด็กขาดเรียน มีบิลค้าง มีใบลารออนุมัติ) ซึ่งเป็นงานออกแบบ ไม่ใช่งานโค้ด และต้องให้ ผอ. ดู
 * ก่อนว่าหน้าตาของ "โรงเรียนตัวอย่าง" ควรเป็นแบบไหน ดู docs/PHASE_DEMO_TODO_DASHBOARD.md
 */
function handleDemoReset(p) {
  if (!demoOn_()) throw apiError_('NOT_DEMO', 'ระบบนี้ไม่ได้เปิดโหมดสาธิต');
  throw apiError_('NOT_READY', 'ชุดข้อมูลสาธิตยังไม่ได้สร้าง — ดู docs/PHASE_DEMO_TODO_DASHBOARD.md');
}
